#include <iostream>
using namespace std;

// The purpose of this section is to store a student's name, GPA, and grade and then print that information.
int main()
{
    string name;
    float gpa;
    string grade;
    cout << "Enter a student's name: " << endl;
    cin >> name;
    cout << endl;
	cout << "Enter the student's GPA: " << endl;
    cin >> gpa;
	cout << endl;
    cout << "Enter the student's grade: " << endl;
	cin >> grade;
    cout << endl;
    cout << "The student's name is: " << name << endl;
    cout << "The student's GPA is: " << gpa << endl;
    cout << "The student's grade is: " << grade << endl;


	// The purpose of this section is to calculate a temperature in Celsius and then convert it to Fahrenheit.
    float celsius;
    float fahrenheit;
    cout << "Enter a temperature in Celsius: " << endl;
    cin >> celsius;
    fahrenheit = (celsius * 9 / 5) + 32;
    cout << "The temperature in Fahrenheit is: " << fahrenheit << endl;
	
	
    
}

