#include <iostream>
#include <string>
using namespace std;

// The purpose of this code is to have the user enter grades for 5 subjects, then calculate the grade using the following grading system:
// 90-100: A
// 80-89: B
// 70-79: C
// 60-69: D
// 0-59: F
// Then display the student's name, the grades for each subject,average grade and the final grade.

int main()
{
	string name;
	int grades[5];
	char finalGrade;
	cout << "Enter student's name: ";
	getline(cin, name);
	cout << "Enter grades for 5 subjects: ";
	for (int i = 0; i < 5; i++) {
		cin >> grades[i];
	}
	int average = (grades[0] + grades[1] + grades[2] + grades[3] + grades[4]) / 5;
	if (average >= 90) {
		finalGrade = 'A';
	}
	else if (average >= 80) {
		finalGrade = 'B';
	}
	else if (average >= 70) {
		finalGrade = 'C';
	}
	else if (average >= 60) {
		finalGrade = 'D';
	}
	else {
		finalGrade = 'F';
	}
	cout << "Student's Name: " << name << endl;
	cout << "Grades: ";
	for (int i = 0; i < 5; i++) {
		cout << grades[i] << " ";
	}
	cout << endl;
	cout << " Average Grade: " << average << endl;
	
	cout << "Final Grade: " << finalGrade << endl;
	
	return 0;

 
}
