#include <iostream>
using namespace std;

// The purpose of this section of code is to create an array with a size of 10 , ask the user to input 10 numbers, 
// then display the maximum and minimum numbers from the array.

int main()
{int arr[10];
int max;
int min;
	cout << "Enter 10 numbers: ";
	for (int i = 0; i < 10; i++) {
		cin >> arr[i];
	}
	max = arr[0];
	min = arr[0];
	for (int i = 1; i < 10; i++) {
		if (arr[i] > max) {
			max = arr[i];
		}
		if (arr[i] < min) {
			min = arr[i];
		}
	}
	cout << "Maximum number: " << max << endl;
	cout << "Minimum number: " << min << endl;
	

	// The purpose of this section of code that computes the average of the numbers in the array and displays it.
	int sum = 0;
	for (int i = 0; i < 10; i++) {
		sum += arr[i];
	}
	float average = static_cast<float>(sum) / 10;
	cout << "Average: " << average << endl;




}
