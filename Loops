#include <iostream>
using namespace std;

// The purpose of this section is to show a for loop that prints all numbers up to 100 that are divisible by 3 and 5.

int main()
{int i;
    for (i = 0; i <= 100; i++)
    {
        if (i % 3 == 0 && i % 5 == 0)
        {
            cout << i << endl;
        }
	}
    
    // The purpose of this section is to use a while loop that adds all numbers entered, until the user enters a negative number.
	int sum = 0;
    int num;
    cout << "Enter a number (negative to stop): ";
    cin >> num;
    while (num >= 0)
    {
        sum += num;
        cout << "Enter a number (negative to stop): ";
        cin >> num;
    }
	cout << "The sum of the numbers entered is: " << sum << endl;

}

